# Salin file ini ke .env (atau .env.local), lalu isi nilainya di sana.
# JANGAN isi key asli di file ini: .env.example ikut ter-push ke GitHub.

# Supabase (Dashboard > Project Settings > API). Juga isi di Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hanya untuk skrip seed di laptop. JANGAN dimasukkan ke Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Portal klien
# URL publik situs untuk link di email (magic link). Kosongkan di lokal.
NEXT_PUBLIC_SITE_URL=https://weavelens.id
# Hanya untuk npm run portal:seed (membuat admin weavelens.studio@gmail.com). Min. 12 karakter.
PORTAL_ADMIN_PASSWORD=
# Opsional: email untuk mencoba login sebagai klien contoh.
PORTAL_DEMO_CLIENT_EMAIL=

# Google Drive (seleksi foto/video): isi file JSON key service account, mentah atau base64. Juga isi di Vercel.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Opsional: string acak untuk hash pengunjung di analitik.
ANALYTICS_SALT=

# Opsional: email pemberitahuan (Resend). Tanpa ini notifikasi hanya muncul di lonceng portal.
# Domain pengirim harus diverifikasi di resend.com. Contoh EMAIL_FROM: WeaveLens <notifikasi@weavelens.id>
RESEND_API_KEY=
EMAIL_FROM=
